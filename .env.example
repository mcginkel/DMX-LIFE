# Copy this file to .env and fill in real values.
# .env is gitignored and never leaves this machine.
#
# start.sh sources this file automatically, then binds to 0.0.0.0 so the
# venue network can reach the UI — which is why credentials are required.

# Required whenever DMXLIFE_HOST is not loopback (start.sh sets it to
# 0.0.0.0). The server refuses to start without both if the bind address
# isn't loopback.
DMXLIFE_USERNAME=admin
DMXLIFE_PASSWORD=change-me

# Optional overrides, left at their defaults here:
# DMXLIFE_HOST=127.0.0.1   # loopback-only; credentials become optional (dev fallback applies)
# DMXLIFE_DEBUG=1          # interactive debugger; refused unless DMXLIFE_HOST is loopback
